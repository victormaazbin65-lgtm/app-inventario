rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function configPath() {
      return /databases/$(database)/documents/sistema/config;
    }

    function authPropietario() {
      return get(configPath()).data
        .get('negocio', {})
        .get('authPropietario', {});
    }

    function propietarioConfigurado() {
      return exists(configPath())
        && authPropietario().get('habilitado', false) == true
        && authPropietario().get('uid', '') != '';
    }

    function esPropietarioAutenticado() {
      return request.auth != null
        && propietarioConfigurado()
        && request.auth.uid == authPropietario().get('uid', '');
    }

    // Cerrado por defecto: no existe acceso público ni adjudicación automática
    // del primer UID. El propietario debe quedar vinculado antes de desplegar
    // estas reglas, siguiendo SEGURIDAD_FIREBASE.md.
    match /{document=**} {
      allow read, write: if esPropietarioAutenticado();
    }
  }
}
